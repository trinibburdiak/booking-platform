generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- eventos (igual en todos los servicios: lo usa @turnos/kafka) ----------

/// Patrón outbox: el evento se guarda en la misma transacción que el cambio y un relay lo publica en Kafka.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  topic       String
  key         String
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, id])
  @@map("outbox")
}

/// Idempotencia de consumidores: eventos ya procesados.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

enum PaymentStatus {
  CREATED
  APPROVED
  REJECTED
  REFUND_PENDING
  REFUNDED
}

/// Una seña por turno. `providerRef`: id de la preferencia (Mercado Pago) o del pago simulado.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @unique @map("booking_id") @db.Uuid
  businessId        String        @map("business_id") @db.Uuid
  clientId          String        @map("client_id") @db.Uuid
  amountCents       Int           @map("amount_cents")
  status            PaymentStatus
  provider          String
  providerRef       String?       @map("provider_ref")
  /// Id del pago en el proveedor (para devoluciones)
  providerPaymentId String?       @map("provider_payment_id")
  checkoutUrl       String?       @map("checkout_url")
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(3)
  lastError         String?       @map("last_error")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([clientId])
  @@map("payments")
}
