generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- eventos (igual en todos los servicios: lo usa @turnos/kafka) ----------

/// Patrón outbox: el evento se guarda en la misma transacción que el cambio y un relay lo publica en Kafka.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  topic       String
  key         String
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, id])
  @@map("outbox")
}

/// Idempotencia de consumidores: eventos ya procesados.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

enum ExceptionType {
  CLOSED
  EXTRA_HOURS
}

model Business {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique
  name              String
  timezone          String
  address           String?
  cancellationHours Int      @default(24) @map("cancellation_hours")
  bookingWindowDays Int      @default(30) @map("booking_window_days")
  minNoticeMinutes  Int      @default(120) @map("min_notice_minutes")
  requiresDeposit   Boolean  @default(false) @map("requires_deposit")
  /// Quién lo creó (la membresía OWNER vive en auth-service)
  createdBy         String   @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  professionals Professional[]
  services      Service[]

  @@map("businesses")
}

model Professional {
  id          String  @id @default(uuid()) @db.Uuid
  businessId  String  @map("business_id") @db.Uuid
  userId      String? @map("user_id") @db.Uuid
  displayName String  @map("display_name")
  active      Boolean @default(true)

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services   ProfessionalService[]
  schedules  Schedule[]
  exceptions ScheduleException[]

  @@index([businessId])
  @@map("professionals")
}

model Service {
  id           String  @id @default(uuid()) @db.Uuid
  businessId   String  @map("business_id") @db.Uuid
  name         String
  durationMin  Int     @map("duration_min")
  bufferMin    Int     @default(0) @map("buffer_min")
  priceCents   Int     @map("price_cents")
  depositCents Int     @default(0) @map("deposit_cents")
  active       Boolean @default(true)

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]

  @@index([businessId])
  @@map("services")
}

model ProfessionalService {
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

/// Hora local del negocio. Varios tramos por día (ej. 9–13 y 16–20).
model Schedule {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  weekday        Int
  startTime      String @map("start_time") @db.VarChar(5)
  endTime        String @map("end_time") @db.VarChar(5)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("schedules")
}

model ScheduleException {
  id             String        @id @default(uuid()) @db.Uuid
  professionalId String        @map("professional_id") @db.Uuid
  /// Fecha local del negocio, YYYY-MM-DD
  date           String        @db.VarChar(10)
  startTime      String?       @map("start_time") @db.VarChar(5)
  endTime        String?       @map("end_time") @db.VarChar(5)
  type           ExceptionType
  reason         String?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, date])
  @@map("schedule_exceptions")
}
