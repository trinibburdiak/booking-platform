generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- eventos (igual en todos los servicios: lo usa @turnos/kafka) ----------

/// Patrón outbox: el evento se guarda en la misma transacción que el cambio y un relay lo publica en Kafka.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  topic       String
  key         String
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, id])
  @@map("outbox")
}

/// Idempotencia de consumidores: eventos ya procesados.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  BOOKING_REMINDER
}

enum NotificationStatus {
  SENT
  FAILED
}

/// Registro de cada aviso enviado (o que falló), para auditoría.
model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  bookingId String             @map("booking_id") @db.Uuid
  channel   String             @default("EMAIL")
  type      NotificationType
  status    NotificationStatus
  error     String?
  sentAt    DateTime           @default(now()) @map("sent_at") @db.Timestamptz(3)

  @@index([bookingId])
  @@map("notifications")
}
