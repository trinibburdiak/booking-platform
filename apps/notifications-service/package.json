{
  "name": "@turnos/notifications-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "11.0.11",
    "@nestjs/core": "11.0.11",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.0.11",
    "@nestjs/platform-socket.io": "11.0.11",
    "@nestjs/swagger": "11.0.6",
    "@nestjs/websockets": "11.0.11",
    "@prisma/client": "6.5.0",
    "@turnos/common": "workspace:*",
    "@turnos/contracts": "workspace:*",
    "@turnos/kafka": "workspace:*",
    "bullmq": "5.34.10",
    "dotenv": "16.4.7",
    "ioredis": "5.4.2",
    "luxon": "3.5.0",
    "nodemailer": "6.9.16",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "11.0.11",
    "@testcontainers/kafka": "10.18.0",
    "@testcontainers/postgresql": "10.18.0",
    "@turnos/testing": "workspace:*",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.4.2",
    "@types/node": "22.13.10",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "6.5.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "testcontainers": "10.18.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "setupFiles": [
      "dotenv/config"
    ],
    "testTimeout": 60000
  }
}
