generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- eventos (igual en todos los servicios: lo usa @turnos/kafka) ----------

/// Patrón outbox: el evento se guarda en la misma transacción que el cambio y un relay lo publica en Kafka.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  topic       String
  key         String
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, id])
  @@map("outbox")
}

/// Idempotencia de consumidores: eventos ya procesados.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

enum ExceptionType {
  CLOSED
  EXTRA_HOURS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  ATTENDED
  NO_SHOW
}

// ---------- réplicas (las alimentan business.events y auth.events; nunca se editan acá) ----------

model Business {
  id                String  @id @db.Uuid
  slug              String  @unique
  name              String
  timezone          String
  address           String?
  cancellationHours Int     @map("cancellation_hours")
  bookingWindowDays Int     @map("booking_window_days")
  minNoticeMinutes  Int     @map("min_notice_minutes")

  professionals Professional[]
  services      Service[]
  bookings      Booking[]

  @@map("business_replica")
}

model Professional {
  id          String  @id @db.Uuid
  businessId  String  @map("business_id") @db.Uuid
  userId      String? @map("user_id") @db.Uuid
  displayName String  @map("display_name")
  active      Boolean

  business   Business              @relation(fields: [businessId], references: [id])
  services   ProfessionalService[]
  schedules  Schedule[]
  exceptions ScheduleException[]
  bookings   Booking[]

  @@index([businessId])
  @@map("professional_replica")
}

model Service {
  id           String  @id @db.Uuid
  businessId   String  @map("business_id") @db.Uuid
  name         String
  durationMin  Int     @map("duration_min")
  bufferMin    Int     @map("buffer_min")
  priceCents   Int     @map("price_cents")
  depositCents Int     @map("deposit_cents")
  active       Boolean

  business      Business              @relation(fields: [businessId], references: [id])
  professionals ProfessionalService[]
  bookings      Booking[]

  @@index([businessId])
  @@map("service_replica")
}

model ProfessionalService {
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_service_replica")
}

model Schedule {
  id             String @id @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  weekday        Int
  startTime      String @map("start_time") @db.VarChar(5)
  endTime        String @map("end_time") @db.VarChar(5)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("schedule_replica")
}

model ScheduleException {
  id             String        @id @db.Uuid
  professionalId String        @map("professional_id") @db.Uuid
  date           String        @db.VarChar(10)
  startTime      String?       @map("start_time") @db.VarChar(5)
  endTime        String?       @map("end_time") @db.VarChar(5)
  type           ExceptionType

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, date])
  @@map("exception_replica")
}

/// Datos de contacto de los clientes (de user.registered), para la agenda y los emails.
model Client {
  id       String  @id @db.Uuid
  email    String
  fullName String  @map("full_name")
  phone    String?

  @@map("client_replica")
}

// ---------- turnos (datos propios) ----------

/// `period` es una columna generada: [starts_at, blocked_until). La usa el
/// exclusion constraint `no_overlap` (ver migración) para impedir el doble booking.
model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  professionalId String        @map("professional_id") @db.Uuid
  serviceId      String        @map("service_id") @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  blockedUntil   DateTime      @map("blocked_until") @db.Timestamptz(3)
  period         Unsupported("tstzrange")?
  status         BookingStatus
  priceCents     Int           @map("price_cents")
  cancelToken    String        @unique @map("cancel_token")
  idempotencyKey String        @map("idempotency_key")
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(3)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  @@unique([clientId, idempotencyKey])
  @@index([businessId, startsAt])
  @@index([clientId, startsAt])
  @@map("bookings")
}
