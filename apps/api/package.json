{
  "name": "@turnos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "11.0.11",
    "@nestjs/core": "11.0.11",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.0.11",
    "@nestjs/swagger": "11.0.6",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.5.0",
    "@turnos/availability": "workspace:*",
    "@turnos/contracts": "workspace:*",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "helmet": "8.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "11.0.11",
    "@testcontainers/postgresql": "10.18.0",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "6.5.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "setupFiles": [
      "dotenv/config"
    ],
    "testTimeout": 60000
  }
}
