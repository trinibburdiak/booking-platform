// Monolito modular (etapa 2): una sola base, pero cada módulo es dueño de sus tablas.
// auth: users, memberships, refresh_tokens
// business: businesses, professionals, services, professional_services, schedules, schedule_exceptions
// booking: bookings

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

enum ExceptionType {
  CLOSED
  EXTRA_HOURS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  ATTENDED
  NO_SHOW
}

// ---------- auth ----------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Membership {
  userId     String @map("user_id") @db.Uuid
  businessId String @map("business_id") @db.Uuid
  role       Role

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ---------- business ----------

model Business {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique
  name              String
  timezone          String
  address           String?
  cancellationHours Int      @default(24) @map("cancellation_hours")
  bookingWindowDays Int      @default(30) @map("booking_window_days")
  minNoticeMinutes  Int      @default(120) @map("min_notice_minutes")
  requiresDeposit   Boolean  @default(false) @map("requires_deposit")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships   Membership[]
  professionals Professional[]
  services      Service[]
  bookings      Booking[]

  @@map("businesses")
}

model Professional {
  id          String  @id @default(uuid()) @db.Uuid
  businessId  String  @map("business_id") @db.Uuid
  userId      String? @map("user_id") @db.Uuid
  displayName String  @map("display_name")
  active      Boolean @default(true)

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services   ProfessionalService[]
  schedules  Schedule[]
  exceptions ScheduleException[]
  bookings   Booking[]

  @@index([businessId])
  @@map("professionals")
}

model Service {
  id           String  @id @default(uuid()) @db.Uuid
  businessId   String  @map("business_id") @db.Uuid
  name         String
  durationMin  Int     @map("duration_min")
  bufferMin    Int     @default(0) @map("buffer_min")
  priceCents   Int     @map("price_cents")
  depositCents Int     @default(0) @map("deposit_cents")
  active       Boolean @default(true)

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  bookings      Booking[]

  @@index([businessId])
  @@map("services")
}

model ProfessionalService {
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

/// Hora local del negocio. Varios tramos por día (ej. 9–13 y 16–20).
model Schedule {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  weekday        Int
  startTime      String @map("start_time") @db.VarChar(5)
  endTime        String @map("end_time") @db.VarChar(5)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("schedules")
}

model ScheduleException {
  id             String        @id @default(uuid()) @db.Uuid
  professionalId String        @map("professional_id") @db.Uuid
  /// Fecha local del negocio, YYYY-MM-DD
  date           String        @db.VarChar(10)
  startTime      String?       @map("start_time") @db.VarChar(5)
  endTime        String?       @map("end_time") @db.VarChar(5)
  type           ExceptionType
  reason         String?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, date])
  @@map("schedule_exceptions")
}

// ---------- booking ----------

/// `period` es una columna generada: [starts_at, blocked_until). La usa el
/// exclusion constraint `no_overlap` (ver migración) para impedir el doble booking.
model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  professionalId String        @map("professional_id") @db.Uuid
  serviceId      String        @map("service_id") @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  /// Fin del servicio (lo que ve el cliente)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  /// Fin del servicio + buffer (lo que ocupa la agenda)
  blockedUntil   DateTime      @map("blocked_until") @db.Timestamptz(3)
  period         Unsupported("tstzrange")?
  status         BookingStatus
  priceCents     Int           @map("price_cents")
  cancelToken    String        @unique @map("cancel_token")
  idempotencyKey String        @map("idempotency_key")
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(3)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  @@unique([clientId, idempotencyKey])
  @@index([businessId, startsAt])
  @@index([clientId, startsAt])
  @@map("bookings")
}

// ---------- notifications ----------

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  BOOKING_REMINDER
}

enum NotificationStatus {
  SENT
  FAILED
}

/// Registro de cada aviso enviado (o que falló), para auditoría y para no duplicar.
model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  bookingId String             @map("booking_id") @db.Uuid
  channel   String             @default("EMAIL")
  type      NotificationType
  status    NotificationStatus
  error     String?
  sentAt    DateTime           @default(now()) @map("sent_at") @db.Timestamptz(3)

  @@index([bookingId])
  @@map("notifications")
}
