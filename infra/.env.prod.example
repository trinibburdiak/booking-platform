# Producción: copiar a infra/.env.prod (no se versiona) y completar.
# Generar secretos con:  openssl rand -hex 32

# Dominio público (con un registro DNS A apuntando al servidor). Caddy saca el certificado HTTPS solo.
SITE_ADDRESS=turnos.tudominio.com
PUBLIC_URL=https://turnos.tudominio.com

POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_TOKEN=

# Email (Resend, Brevo, Mailgun, SES…). Sin SMTP_HOST, los emails no se envían (quedan solo en el log).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Turnos <turnos@tudominio.com>

# Mercado Pago. Vacío = checkout simulado (sirve para la demo).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Imágenes publicadas por el workflow de deploy (vacío = se construyen en el servidor)
TURNOS_IMAGE=
TURNOS_WEB_IMAGE=
